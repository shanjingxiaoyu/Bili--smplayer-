# 换行符：Windows 项目统一 CRLF，文本文件自动转换
* text=auto

# 源码（UTF-8，CRLF）
*.py text eol=crlf
*.pyw text eol=crlf
*.md text eol=crlf
*.bat text eol=crlf
*.txt text eol=crlf
*.spec text eol=crlf

# 二进制文件（不转换换行符、不 diff）
*.exe binary
*.dll binary
*.ico binary
*.png binary
*.jpg binary
*.zip binary
*.tar.gz binary
*.pyz binary
